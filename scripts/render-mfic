#!/usr/bin/env bash
# Renders /thoughts/mfic/index.html from the canonical ~/Documents/MFIC.md.
#
# NO-DRIFT design: the methodology *body* has exactly one source — MFIC.md — and
# is rendered here with pandoc. The buyer-framed hero + cross-links are bespoke
# page chrome (unique to this page, duplicated nowhere, so they can't drift). The
# deep-dive sections (everything from the first "## ") are NOT inlined; the page
# links the public gist (which also mirrors MFIC.md) for those.
#
# This is a LOCAL author step: it reads a home-dir file and writes a committed
# artifact that GitHub Pages serves. Re-run whenever MFIC.md changes.
set -u

SRC="${MFIC_SRC:-$HOME/Documents/MFIC.md}"
OUT_DIR="$(cd "$(dirname "$0")/.." && pwd)/thoughts/mfic"
OUT="${MFIC_OUT:-$OUT_DIR/index.html}"
GIST="https://gist.github.com/pmarreck/b30aa3ca69cb70a5526f8a63ab8c8d7e"

if [ ! -f "$SRC" ]; then echo "render-mfic: canonical source not found: $SRC" >&2; exit 1; fi
command -v pandoc >/dev/null 2>&1 || { echo "render-mfic: pandoc required" >&2; exit 1; }

mkdir -p "$OUT_DIR"

# Core = from the "How to trust…" line up to (not including) the first "## " section.
# (Skips MFIC.md's own H1 + tagline — the bespoke hero covers those.)
CORE_HTML="$(awk '/^## /{exit} /^How to trust/{p=1} p{print}' "$SRC" | pandoc -f gfm -t html)"

cat > "$OUT" <<HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>MFIC — trusting AI output enough to put your name on it — Mecha LLC</title>
  <meta name="description" content="MFIC (Mechanically-Falsifiable Independent Control): the assurance discipline behind trustworthy AI output — independent controls at every handoff, the internal-control model behind Sarbanes-Oxley, with the LLM as the new untrusted party.">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
  <meta name="theme-color" content="#0f1115">
  <meta property="og:title" content="MFIC — trusting AI output enough to put your name on it">
  <meta property="og:description" content="The assurance discipline behind trustworthy AI output — independent controls at every handoff, the discipline behind Sarbanes-Oxley.">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://mecha.llc/thoughts/mfic/">
  <link rel="stylesheet" href="/assets/css/site.css">
  <script defer src="/assets/js/site.js"></script>
</head>
<body>
  <div class="page">
    <nav class="site-nav">
      <a href="/" class="brand">MECHA · LLC</a>
      <div class="links">
        <a href="/consulting/">Consulting</a>
        <a href="/software/">Software</a>
        <a href="/contact/">Contact</a>
      </div>
    </nav>

    <main class="work">
      <section class="hero reveal">
        <p class="eyebrow">Thoughts · Methodology</p>
        <h1>Trusting AI output enough<br>to put your name on it.</h1>
        <p class="subhead"><strong>MFIC — Mechanically-Falsifiable Independent Control</strong> is a discipline for exactly that: independent checks at every handoff that derive their verdict from the contract or the data, never from the producer&rsquo;s say-so, and hold the authority to reject or halt. It is the internal-control model behind <strong>Sarbanes-Oxley</strong> (COSO) — segregation of duties, preventive and detective controls, audit trails, reasonable assurance — with the LLM (or a hurried human) as the new untrusted party.</p>
        <p class="subhead">For regulated, high-stakes work, that is the difference between &ldquo;the AI said so&rdquo; and an answer you can defend under audit. It&rsquo;s the discipline behind everything Mecha builds — and the reason a verification result here comes with a gate, not a promise.</p>
      </section>

      <section class="legal reveal mfic-body">
${CORE_HTML}
      </section>

      <section class="reveal">
        <p class="lead" style="max-width:760px">This is the working summary. The full technical treatment — the independence axis in depth, the producer/approver pattern, the escalation from policy to blocking gates to cryptographic controls, and five worked examples — lives in the <a href="${GIST}" target="_blank" rel="noopener">complete MFIC methodology</a>.</p>
        <div class="btn-row" style="margin-top:18px">
          <a class="btn btn-primary" href="/work/incitez/">See it in practice: incitez &rarr;</a>
          <a class="btn btn-secondary" href="/consulting/">The consulting practice &rarr;</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <nav class="footer-links" aria-label="Legal and contact">
        <a href="/legal/terms/">Terms</a>
        <a href="/legal/privacy/">Privacy</a>
        <a href="/legal/refund/">Refunds</a>
        <a href="/contact/">Contact</a>
      </nav>
      <p class="footer-copy">&copy; Mecha,&nbsp;LLC &middot; downloadable data-integrity software for macOS &amp; Windows.</p>
    </footer>
  </div>
</body>
</html>
HTML

echo "render-mfic: wrote $OUT ($(wc -l < "$OUT") lines) from $SRC"
